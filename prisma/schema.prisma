generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Location {
  id        String   @id @default(cuid())
  visitorId String
  latitude  Float
  longitude Float
  accuracy  Float?
  createdAt DateTime @default(now())

  @@index([visitorId])
  @@index([createdAt])
}